# Contact form delivery (POST /api/contact).
# Copy to .env.local for local development, and set the same names in
# Vercel → Project → Settings → Environment Variables (or run `npm run env:push`).

SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@hikmahsphere.site
SMTP_PASS=your-zoho-app-password
SMTP_FROM="HikmahSphere <info@hikmahsphere.site>"
SMTP_TO=info@hikmahsphere.site

# Optional: restrict which sites may post to the embeddable widget's API.
# Default is `*` (any origin). Use exact origins, comma-separated.
CONTACT_ALLOWED_ORIGINS=*
